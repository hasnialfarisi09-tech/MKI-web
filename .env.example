# URL Google Apps Script Web App
# Harus prefix NEXT_PUBLIC_ agar bisa dibaca di client-side (static export / Capacitor)
# Dapatkan URL ini setelah deploy Apps Script (lihat docs/google-apps-script.js)
# Contoh: https://script.google.com/macros/s/AKfycb.../exec
NEXT_PUBLIC_APPS_SCRIPT_URL=
